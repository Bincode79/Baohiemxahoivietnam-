# Database Configuration
# Option 1: Full connection string (recommended for cloud databases like Neon)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Option 2: Individual connection parameters (for local databases)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bhxh
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false

# Pool size (default 10, min 5, max 20)
# DB_POOL_SIZE=10

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Environment: development | production
NODE_ENV=development

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Rate Limiting (optional, defaults are set in code)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Body parser limit for JSON (default 5mb)
# JSON_BODY_LIMIT=5mb

# Trust proxy (Express): default loopback,linklocal,uniquelocal (RFC1918 only)
# Override khi deploy sau proxy (vd "1" nếu có 1 reverse proxy đáng tin)
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Admin seed credentials - KHUYẾN NGHỊ set cả 2 khi deploy production.
# Nếu thiếu ADMIN_PASSWORD ở production, server sẽ REFUSE khởi động.
# Username mặc định: admin. Nên đổi username cho production.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong-password

# Redis (optional). Nếu set sẽ dùng Redis làm session store thay cho in-memory.
# Cần cài ioredis: npm install ioredis
# REDIS_URL=redis://localhost:6379

# Lưu ảnh đăng ký ra disk thay vì base64 trong DB (giảm ~33% dung lượng).
# Set =true để bật. Nếu tắt, ảnh sẽ tiếp tục được lưu vào cột *_data (base64).
STORE_IMAGES_ON_DISK=false

# CSP Report-Only mode. Set =true để browser thu thập vi phạm CSP gửi về /api/csp-report
# nhưng vẫn render page. Sau khi review log, có thể promote thành enforce mode.
# CSP_REPORT_ONLY=false